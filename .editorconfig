root = true

[{Package.swift,Sources/{AirPlayViewer,MirrorCore,WindowLayout}/**.swift,Tests/**.swift}]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[{scripts/*.sh,.github/workflows/*.yml}]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
